rules_version = '2';
// Luật bảo mật GlowBoard – dán toàn bộ file này vào Firebase Console → Firestore → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // Tài khoản Admin (chỉ bạn): tạo team, đổi mã, khóa team, xem mọi board
    function isAdmin() {
      return request.auth != null && request.auth.uid == "mCdN9oXNpHZlQ7qthXKpHwwEpPn1";
    }
    function teamDoc(t) {
      return get(/databases/$(database)/documents/teams/$(t));
    }
    function memberPath(t) {
      return /databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid);
    }
    // Máy này đã vào team bằng mã HIỆN TẠI của team (đổi mã là mất quyền ngay)
    function hasCurrentCode(t) {
      return request.auth != null
        && exists(memberPath(t))
        && get(memberPath(t)).data.code == teamDoc(t).data.code;
    }
    // Thành viên được đọc / ghi board khi có mã đúng và team không bị khóa
    function isMember(t) {
      return hasCurrentCode(t) && teamDoc(t).data.locked == false;
    }

    // Tra mã team → team nào. Chỉ đọc được đúng mã mình nhập, không liệt kê được danh sách mã.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow list, write: if isAdmin();
    }

    match /teams/{t} {
      allow get: if isAdmin() || hasCurrentCode(t);
      allow list, write: if isAdmin();

      // Mỗi máy trong team (tên hiển thị + mã đã dùng để vào)
      match /members/{uid} {
        allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow list: if isAdmin();
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["name", "code", "joinedAt", "lastSeen"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.code == teamDoc(t).data.code
          && teamDoc(t).data.locked == false;
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }

      // Các đầu mục trên board của team
      match /items/{itemId} {
        allow read, write: if isAdmin() || isMember(t);
      }
    }
  }
}
